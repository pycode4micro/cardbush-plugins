# Copy outside the plugin, e.g. ~/.config/feishu-bot/.env. Never commit real credentials.
# Startup flags --allow-read/--no-allow-read and --allow-write/--no-allow-write override these.
FEISHU_ALLOW_READ=true
FEISHU_ALLOW_WRITE=false

# Internal application bot (recommended). App must be published and have resource permissions.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional pre-issued tenant token. Takes precedence over app credentials; not auto-refreshed.
FEISHU_TENANT_ACCESS_TOKEN=

# Custom group bot (send-only, cannot read sheets/messages). Configure only when needed.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Feishu: https://open.feishu.cn; Lark: https://open.larksuite.com
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT_SECONDS=30

# Copy to the configuration_file returned by qianchuan_setup_status.
# Never copy the desktop service's database or production credentials implicitly.
APP_ENV=prod
LOCAL_API_KEY=
OAUTH_GATEWAY_BASE_URL=https://www.cardbush.com
OAUTH_GATEWAY_HMAC_SECRET=
OAUTH_GATEWAY_TOKEN_NO=
QIANCHUAN_ALLOWED_ADVERTISER_IDS=
QIANCHUAN_ALLOW_ALL_AUTHORIZED_ADVERTISERS=false
QIANCHUAN_WRITE_ENABLED=false
QIANCHUAN_LIVE_CREATE_ENABLED=false
QIANCHUAN_REQUIRE_ACCOUNT_POLICY_FOR_WRITES=true
QIANCHUAN_MCP_ADMIN_TOOLS_ENABLED=false
OUTBOUND_HTTP_TRUST_ENV=false

{
  "mcpServers": {
    "tencent-cos-upload": {
      "command": "python",
      "args": ["-m", "cos_upload_mcp"],
      "env_vars": ["TENCENT_COS_SECRET_ID", "TENCENT_COS_SECRET_KEY", "TENCENT_COS_TOKEN", "TENCENT_COS_BUCKET", "TENCENT_COS_REGION", "TENCENT_COS_PREFIX", "TENCENT_COS_PUBLIC_BASE_URL", "TENCENT_COS_USE_PRESIGNED_URL", "TENCENT_COS_PRESIGNED_EXPIRES_SECONDS", "COS_SECRET_ID", "COS_SECRET_KEY", "COS_TOKEN", "COS_BUCKET", "COS_REGION", "COS_UPLOAD_READ_USER_ENV", "COS_UPLOAD_ALLOWED_ROOT", "COS_UPLOAD_TIMEOUT_SECONDS"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 1800
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "feishu": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}", "--frozen", "--no-dev", "feishu-bot", "--allow-write"],
      "env": {"UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv", "PYTHONUTF8": "1"},
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
